{
    "$schema": "https://swc.rs/schema.json",
    "sourceMaps": true,
    "jsc": {
      "parser": {
        "syntax": "typescript",
        "decorators": true,
        "dynamicImport": true
      },
      "transform": {
        "legacyDecorator": true,
        "decoratorMetadata": true
      },
      "baseUrl": "./",
      "paths": {
        "@/src/*": ["src/*"],  
        "@/app/*": ["src/app/*"],
        "@/shared/*": ["src/shared/*"],
        "@/tests/*": ["tests/*"]
      },
      "target": "es2022"
    },
    "minify": false
  }